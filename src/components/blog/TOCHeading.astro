---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class={`${depth > 2 ? "ms-2" : ""} break-words`}>
	<a
				class={`block hover:text-accent ${
				depth === 1
					? "mt-3 font-semibold text-sm"
					: depth === 2
						? "mt-3 text-sm"
						: "mt-2 text-xs text-muted"
				}`}
		href={`#${slug}`}>{text}</a
	>
	{
		!!children.length && (
			<ol>
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>
