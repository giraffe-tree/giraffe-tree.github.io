---
// 矩阵网格波浪粒子背景
// 由无数小方块组成的浩瀚波浪效果
---

<div class="particle-background" aria-hidden="true">
  <canvas id="particle-canvas"></canvas>
</div>

<script>
  class MatrixWaveSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: MatrixParticle[] = [];
    animationId: number = 0;
    time: number = 0;
    mouse = { x: 0, y: 0, active: false };

    // 网格配置
    config = {
      particleSize: 4,          // 每个粒子（方块）的大小
      gap: 2,                   // 粒子之间的间隙
      waveHeight: 150,          // 波浪高度
      waveSpeed: 0.02,          // 波浪速度
      waveFrequency: 0.008,     // 波浪频率
    };

    constructor() {
      this.canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;

      this.ctx = this.canvas.getContext('2d')!;
      this.init();
    }

    init() {
      this.resize();
      this.createParticles();
      this.bindEvents();
      this.animate();
    }

    resize() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;
      this.createParticles(); // 重新创建粒子以适应新尺寸
    }

    createParticles() {
      this.particles = [];

      const cols = Math.ceil(this.canvas.width / (this.config.particleSize + this.config.gap));
      const rows = Math.ceil(this.canvas.height / (this.config.particleSize + this.config.gap));

      // 创建网格粒子
      for (let col = 0; col < cols; col++) {
        for (let row = 0; row < rows; row++) {
          const x = col * (this.config.particleSize + this.config.gap);
          const y = row * (this.config.particleSize + this.config.gap);

          this.particles.push(new MatrixParticle(
            x,
            y,
            this.config.particleSize,
            col,
            row
          ));
        }
      }
    }

    bindEvents() {
      window.addEventListener('resize', () => {
        this.resize();
      }, { passive: true });

      window.addEventListener('mousemove', (e) => {
        this.mouse.x = e.clientX;
        this.mouse.y = e.clientY;
        this.mouse.active = true;
      }, { passive: true });

      window.addEventListener('mouseleave', () => {
        this.mouse.active = false;
      });
    }

    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.time += 1;

      // 计算波浪中心点
      const waveCenterY = this.canvas.height * 0.6;

      this.particles.forEach((particle) => {
        // 计算波浪偏移
        const waveOffset = this.calculateWaveOffset(particle.baseX, particle.baseY, waveCenterY);

        particle.update(waveOffset, this.mouse, this.time);
        particle.draw(this.ctx);
      });

      this.animationId = requestAnimationFrame(() => this.animate());
    }

    calculateWaveOffset(x: number, y: number, centerY: number): number {
      // 多层正弦波叠加
      const wave1 = Math.sin(x * this.config.waveFrequency + this.time * this.config.waveSpeed);
      const wave2 = Math.sin(x * this.config.waveFrequency * 2.5 + this.time * this.config.waveSpeed * 1.3) * 0.5;
      const wave3 = Math.sin(x * this.config.waveFrequency * 0.5 + this.time * this.config.waveSpeed * 0.7) * 0.3;

      // 距离中心的衰减
      const distFromCenter = Math.abs(y - centerY) / (this.canvas.height * 0.5);
      const attenuation = Math.max(0, 1 - distFromCenter * 1.5);

      return (wave1 + wave2 + wave3) * this.config.waveHeight * attenuation;
    }

    destroy() {
      cancelAnimationFrame(this.animationId);
    }
  }

  class MatrixParticle {
    baseX: number;
    baseY: number;
    x: number;
    y: number;
    size: number;
    col: number;
    row: number;
    opacity: number;
    targetOpacity: number;

    constructor(x: number, y: number, size: number, col: number, row: number) {
      this.baseX = x;
      this.baseY = y;
      this.x = x;
      this.y = y;
      this.size = size;
      this.col = col;
      this.row = row;
      this.opacity = 0;
      this.targetOpacity = Math.random() * 0.3;
    }

    update(waveOffset: number, mouse: { x: number; y: number; active: boolean }, time: number) {
      // 应用波浪偏移
      this.y = this.baseY + waveOffset;

      // 基础透明度（基于波浪高度）
      const waveOpacity = 0.15 + Math.max(0, -waveOffset / 100) * 0.4;

      // 鼠标交互
      let mouseEffect = 0;
      if (mouse.active) {
        const dx = this.baseX - mouse.x;
        const dy = this.baseY - mouse.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < 150) {
          mouseEffect = (1 - distance / 150) * 0.5;
        }
      }

      // 闪烁效果
      const twinkle = Math.sin(time * 0.05 + this.col * 0.1 + this.row * 0.1) * 0.05;

      this.targetOpacity = Math.min(0.8, waveOpacity + mouseEffect + twinkle);
      this.opacity += (this.targetOpacity - this.opacity) * 0.1;
    }

    draw(ctx: CanvasRenderingContext2D) {
      if (this.opacity < 0.01) return;

      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

      // 颜色基于波浪高度变化
      const heightFactor = Math.max(0, Math.min(1, (this.y - this.baseY + 100) / 200));

      let r, g, b;
      if (isDark) {
        // 暗色模式：银灰色调
        const intensity = 120 + heightFactor * 80;
        r = intensity;
        g = intensity + 10;
        b = intensity + 20;
      } else {
        // 亮色模式：灰蓝色调
        const intensity = 80 - heightFactor * 30;
        r = intensity + 20;
        g = intensity + 30;
        b = intensity + 50;
      }

      ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${this.opacity})`;
      ctx.fillRect(this.x, this.y, this.size, this.size);
    }
  }

  // 初始化
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        new MatrixWaveSystem();
      });
    } else {
      new MatrixWaveSystem();
    }
  }
</script>

<style>
  .particle-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  #particle-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
