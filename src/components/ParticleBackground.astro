---
// 康威生命游戏波浪背景
// 使用细胞自动机生成动态波浪效果
---

<div class="particle-background" aria-hidden="true">
  <canvas id="particle-canvas"></canvas>
</div>

<script>
  class GameOfLifeWave {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    cols: number = 0;
    rows: number = 0;
    cellSize: number = 6;
    gap: number = 2;
    grid: number[][] = [];
    nextGrid: number[][] = [];
    colors: number[][] = []; // 0 = white, 1 = green
    animationId: number = 0;
    generation: number = 0;
    waveOffset: number = 0;

    // 颜色配置
    colorsConfig = {
      white: { r: 220, g: 220, b: 220 },
      green: { r: 80, g: 180, b: 120 },
      darkWhite: { r: 160, g: 160, b: 160 },
      darkGreen: { r: 60, g: 140, b: 100 },
    };

    constructor() {
      this.canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;

      this.ctx = this.canvas.getContext('2d')!;
      this.init();
    }

    init() {
      this.resize();
      this.randomizeGrid();
      this.bindEvents();
      this.animate();
    }

    resize() {
      this.canvas.width = window.innerWidth;
      this.canvas.height = window.innerHeight;

      this.cols = Math.ceil(this.canvas.width / (this.cellSize + this.gap));
      this.rows = Math.ceil(this.canvas.height / (this.cellSize + this.gap));

      this.initGrids();
    }

    initGrids() {
      this.grid = Array(this.rows).fill(null).map(() => Array(this.cols).fill(0));
      this.nextGrid = Array(this.rows).fill(null).map(() => Array(this.cols).fill(0));
      this.colors = Array(this.rows).fill(null).map(() => Array(this.cols).fill(0));
    }

    randomizeGrid() {
      // 初始化随机状态，中间区域更密集
      const centerX = Math.floor(this.cols / 2);
      const centerY = Math.floor(this.rows / 2);

      for (let y = 0; y < this.rows; y++) {
        for (let x = 0; x < this.cols; x++) {
          const distFromCenter = Math.sqrt((x - centerX) ** 2 + (y - centerY) ** 2);
          const maxDist = Math.sqrt(centerX ** 2 + centerY ** 2);
          const probability = 0.08 + 0.07 * (1 - distFromCenter / maxDist);

          // 随机生成活细胞
          this.grid[y][x] = Math.random() < probability ? 1 : 0;

          // 随机分配颜色（白色或绿色）
          this.colors[y][x] = Math.random() < 0.5 ? 0 : 1;
        }
      }
    }

    countNeighbors(row: number, col: number): number {
      let count = 0;
      for (let i = -1; i <= 1; i++) {
        for (let j = -1; j <= 1; j++) {
          if (i === 0 && j === 0) continue;

          const newRow = row + i;
          const newCol = col + j;

          if (newRow >= 0 && newRow < this.rows && newCol >= 0 && newCol < this.cols) {
            count += this.grid[newRow][newCol];
          }
        }
      }
      return count;
    }

    computeNextGeneration() {
      for (let y = 0; y < this.rows; y++) {
        for (let x = 0; x < this.cols; x++) {
          const neighbors = this.countNeighbors(y, x);
          const currentState = this.grid[y][x];

          // 康威生命游戏规则
          if (currentState === 1) {
            // 活细胞：2或3个邻居存活，否则死亡
            this.nextGrid[y][x] = (neighbors === 2 || neighbors === 3) ? 1 : 0;
          } else {
            // 死细胞：3个邻居存活则复活，或0.05%概率随机生成
            this.nextGrid[y][x] = (neighbors === 3 || Math.random() < 0.0005) ? 1 : 0;
          }

          // 如果细胞复活且原本是死的，随机分配新颜色
          if (this.nextGrid[y][x] === 1 && currentState === 0) {
            this.colors[y][x] = Math.random() < 0.5 ? 0 : 1;
          }
        }
      }

      // 交换网格
      [this.grid, this.nextGrid] = [this.nextGrid, this.grid];
      this.generation++;
    }

    bindEvents() {
      window.addEventListener('resize', () => {
        this.resize();
        this.randomizeGrid();
      }, { passive: true });

    }

    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      // 每10帧更新一次生命游戏
      if (this.generation % 10 === 0) {
        this.computeNextGeneration();
      }

      // 波浪偏移动画
      this.waveOffset += 0.02;

      // 绘制网格
      this.drawGrid();

      this.generation++;
      this.animationId = requestAnimationFrame(() => this.animate());
    }

    drawGrid() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const centerY = this.rows / 2;

      for (let y = 0; y < this.rows; y++) {
        for (let x = 0; x < this.cols; x++) {
          if (this.grid[y][x] === 0) continue;

          const posX = x * (this.cellSize + this.gap);
          const posY = y * (this.cellSize + this.gap);

          // 计算波浪偏移
          const distFromCenter = (y - centerY) / centerY;
          const wavePhase = x * 0.1 + this.waveOffset;
          const waveOffset = Math.sin(wavePhase) * 30 * (1 - Math.abs(distFromCenter));

          const finalY = posY + waveOffset;

          // 根据距离中心的远近调整透明度（形成波浪效果）
          const opacity = 0.4 + 0.4 * (1 - Math.abs(distFromCenter));

          // 获取颜色
          const colorType = this.colors[y][x];
          let r, g, b;

          if (isDark) {
            if (colorType === 0) {
              r = this.colorsConfig.darkWhite.r;
              g = this.colorsConfig.darkWhite.g;
              b = this.colorsConfig.darkWhite.b;
            } else {
              r = this.colorsConfig.darkGreen.r;
              g = this.colorsConfig.darkGreen.g;
              b = this.colorsConfig.darkGreen.b;
            }
          } else {
            if (colorType === 0) {
              r = this.colorsConfig.white.r;
              g = this.colorsConfig.white.g;
              b = this.colorsConfig.white.b;
            } else {
              r = this.colorsConfig.green.r;
              g = this.colorsConfig.green.g;
              b = this.colorsConfig.green.b;
            }
          }

          this.ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${opacity})`;
          this.ctx.fillRect(posX, finalY, this.cellSize, this.cellSize);
        }
      }
    }

    destroy() {
      cancelAnimationFrame(this.animationId);
    }
  }

  // 初始化
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        new GameOfLifeWave();
      });
    } else {
      new GameOfLifeWave();
    }
  }
</script>

<style>
  .particle-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    background: linear-gradient(180deg,
      rgba(20, 25, 35, 1) 0%,
      rgba(30, 35, 50, 1) 50%,
      rgba(25, 30, 40, 1) 100%
    );
  }

  #particle-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
