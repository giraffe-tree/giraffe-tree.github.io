---
// 波浪粒子背景特效组件
// 使用正弦波实现大海波浪般的流动效果
---

<div class="particle-background" aria-hidden="true">
  <canvas id="particle-canvas"></canvas>
</div>

<script>
  class WaveParticleSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: WaveParticle[] = [];
    animationId: number = 0;
    time: number = 0;
    mouse = { x: 0, y: 0, active: false };

    // 波浪配置
    config = {
      particleCount: 350,       // 粒子总数
      layers: 3,                // 波浪层数
      baseSpeed: 0.02,         // 基础流动速度
    };

    // 每层波浪的配置
    layerConfigs = [
      { frequency: 0.008, amplitude: 60, speed: 0.015, opacity: 0.15, size: 2.5, yOffset: 0.3 },    // 远景
      { frequency: 0.012, amplitude: 45, speed: 0.025, opacity: 0.25, size: 2, yOffset: 0.5 },      // 中景
      { frequency: 0.018, amplitude: 30, speed: 0.035, opacity: 0.35, size: 1.5, yOffset: 0.7 },    // 近景
    ];

    constructor() {
      this.canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;

      this.ctx = this.canvas.getContext('2d')!;
      this.init();
    }

    init() {
      this.resize();
      this.createParticles();
      this.bindEvents();
      this.animate();
    }

    resize() {
      const parent = this.canvas.parentElement;
      if (parent) {
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
      }
    }

    createParticles() {
      this.particles = [];

      for (let layer = 0; layer < this.config.layers; layer++) {
        const layerConfig = this.layerConfigs[layer];
        const particlesPerLayer = Math.floor(this.config.particleCount / this.config.layers);

        for (let i = 0; i < particlesPerLayer; i++) {
          this.particles.push(new WaveParticle(
            this.canvas.width,
            this.canvas.height,
            layer,
            layerConfig,
            i / particlesPerLayer // 在波浪上均匀分布
          ));
        }
      }
    }

    bindEvents() {
      window.addEventListener('resize', () => {
        this.resize();
        this.createParticles();
      }, { passive: true });

      window.addEventListener('mousemove', (e) => {
        this.mouse.x = e.clientX;
        this.mouse.y = e.clientY;
        this.mouse.active = true;
      }, { passive: true });

      window.addEventListener('mouseleave', () => {
        this.mouse.active = false;
      });
    }

    animate() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      this.time += 1;

      // 按层排序粒子（远景先画）
      const sortedParticles = [...this.particles].sort((a, b) => a.layer - b.layer);

      sortedParticles.forEach((particle) => {
        particle.update(this.canvas.width, this.canvas.height, this.time);
        particle.draw(this.ctx);
      });

      // 鼠标涟漪效果
      if (this.mouse.active) {
        this.drawMouseRipple();
      }

      this.animationId = requestAnimationFrame(() => this.animate());
    }

    drawMouseRipple() {
      const rippleRadius = 100;
      const gradient = this.ctx.createRadialGradient(
        this.mouse.x, this.mouse.y, 0,
        this.mouse.x, this.mouse.y, rippleRadius
      );

      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const color = isDark ? '160, 180, 200' : '80, 100, 120';

      gradient.addColorStop(0, `rgba(${color}, 0.1)`);
      gradient.addColorStop(1, `rgba(${color}, 0)`);

      this.ctx.fillStyle = gradient;
      this.ctx.fillRect(
        this.mouse.x - rippleRadius,
        this.mouse.y - rippleRadius,
        rippleRadius * 2,
        rippleRadius * 2
      );
    }

    destroy() {
      cancelAnimationFrame(this.animationId);
    }
  }

  class WaveParticle {
    x: number;
    y: number;
    baseY: number;
    layer: number;
    phase: number;
    size: number;
    opacity: number;
    speed: number;
    frequency: number;
    amplitude: number;
    yOffset: number;

    constructor(
      canvasWidth: number,
      canvasHeight: number,
      layer: number,
      config: {
        frequency: number;
        amplitude: number;
        speed: number;
        opacity: number;
        size: number;
        yOffset: number;
      },
      phase: number
    ) {
      this.layer = layer;
      this.phase = phase;
      this.frequency = config.frequency;
      this.amplitude = config.amplitude;
      this.speed = config.speed;
      this.opacity = config.opacity;
      this.size = config.size + Math.random() * 1.5;
      this.yOffset = config.yOffset;

      // 初始位置
      this.x = Math.random() * canvasWidth;
      this.baseY = canvasHeight * this.yOffset;
      this.y = this.baseY;
    }

    update(canvasWidth: number, canvasHeight: number, time: number) {
      // 波浪运动：从左向右流动
      this.x += this.speed;

      // 如果超出右边界，从左侧重新进入
      if (this.x > canvasWidth + 50) {
        this.x = -50;
      }

      // 更新基础Y位置（随窗口高度调整）
      this.baseY = canvasHeight * this.yOffset;

      // 正弦波计算Y位置
      // 使用多个正弦波叠加产生更自然的波浪
      const wave1 = Math.sin(this.x * this.frequency + time * 0.02);
      const wave2 = Math.sin(this.x * this.frequency * 1.5 + time * 0.03 + this.phase * Math.PI * 2);

      this.y = this.baseY + (wave1 * 0.7 + wave2 * 0.3) * this.amplitude;
    }

    draw(ctx: CanvasRenderingContext2D) {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

      // 波浪颜色：灰蓝色调
      let r, g, b;
      if (isDark) {
        // 暗色模式：浅灰蓝
        r = 140 + this.layer * 20;
        g = 160 + this.layer * 20;
        b = 180 + this.layer * 20;
      } else {
        // 亮色模式：深灰蓝
        r = 100 - this.layer * 15;
        g = 120 - this.layer * 15;
        b = 140 - this.layer * 15;
      }

      // 根据Y位置调整透明度（波浪顶部更亮）
      const opacityMod = 1 + Math.sin(this.y * 0.01) * 0.2;
      const finalOpacity = this.opacity * opacityMod;

      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${finalOpacity})`;
      ctx.fill();

      // 添加发光效果（仅近景层）
      if (this.layer === 2) {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size * 2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${finalOpacity * 0.3})`;
        ctx.fill();
      }
    }
  }

  // 初始化
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        new WaveParticleSystem();
      });
    } else {
      new WaveParticleSystem();
    }
  }
</script>

<style>
  .particle-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.8;
  }

  #particle-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
