---
import { menuLinks } from "@/site.config";
import { siteConfig } from "../../site.config";
---

<header class="mb-16 flex items-center justify-between" id="main-header">
  <a
    aria-current={Astro.url.pathname === "/" ? "page" : false}
    class="text-global-text hover:text-accent text-lg font-medium transition-colors"
    href="/"
  >
    {siteConfig.title}
  </a>

  <nav aria-label="Main menu" class="flex items-center gap-6">
    {
      menuLinks.map((link) => (
        <a
          aria-current={Astro.url.pathname === link.path ? "page" : false}
          class={`text-sm transition-colors ${
            Astro.url.pathname === link.path
              ? "text-accent"
              : "text-muted hover:text-global-text"
          }`}
          href={link.path}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>
