---
import { Icon } from "astro-icon/components";
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="mt-auto pt-16 pb-8">
	<div class="flex flex-col items-center gap-6">
		<!-- 简化的导航 -->
		<nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
			{menuLinks.map((link) => (
				<a
					href={link.path}
					class="text-muted hover:text-[var(--color-link)] transition-colors duration-200"
				>
					{link.title}
				</a>
			))}
			<a
				href="/rss.xml"
				class="text-muted hover:text-[var(--color-link)] transition-colors duration-200"
			>
				RSS
			</a>
		</nav>

		<!-- 社交链接 -->
		<div class="flex items-center gap-4">
			<a
				href="https://github.com/giraffe-tree"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
				class="text-muted hover:text-[var(--color-link)] transition-colors duration-200"
			>
				<Icon name="mdi:github" class="w-5 h-5" />
			</a>
			<a
				href="mailto:giraffetree1@gmail.com"
				aria-label="Email"
				class="text-muted hover:text-[var(--color-link)] transition-colors duration-200"
			>
				<Icon name="mdi:email" class="w-5 h-5" />
			</a>
		</div>

		<!-- 版权信息 -->
		<div class="text-center text-xs text-muted/70">
			<p>&copy; {year} {siteConfig.author}. All rights reserved.</p>
			<p class="mt-1 flex items-center justify-center gap-1">
				<span>Built with</span>
				<Icon name="mdi:heart" class="w-3 h-3 text-red-400" />
				<span>using Astro</span>
			</p>
		</div>
	</div>
</footer>
