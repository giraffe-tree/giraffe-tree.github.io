---
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];

// Filter posts by category tags
const projects = allPostsByDate.filter(p => p.data.tags.includes("项目"));
const writings = allPostsByDate.filter(p => p.data.tags.includes("写作") || p.data.tags.includes("blog"));
const photography = allPostsByDate.filter(p => p.data.tags.includes("摄影") || p.data.tags.includes("photo"));
const travel = allPostsByDate.filter(p => p.data.tags.includes("旅行") || p.data.tags.includes("travel"));

const categories = [
  { id: "projects", name: "项目", posts: projects },
  { id: "writings", name: "写作", posts: writings },
  { id: "photography", name: "摄影", posts: photography },
  { id: "travel", name: "旅行", posts: travel },
];

const tags = ["9年经验", "人本主义", "build in public"];
---

<PageLayout meta={{ title: "Home" }} showHeader={false}>
  <div class="space-y-6">
    <!-- 第1层：工具栏 -->
    <div class="flex items-center justify-end gap-3 text-sm pb-4 border-b border-[var(--color-border)]">
      <div class="flex items-center gap-1.5">
        <div class="flex gap-0.5" id="language-switcher">
          <button data-lang="en" class="lang-btn px-2 py-1 rounded transition-all duration-200 text-muted hover:text-[var(--color-global-text)] hover:bg-[var(--color-global-bg)]">EN</button>
          <span class="text-muted">/</span>
          <button data-lang="zh" class="lang-btn px-2 py-1 rounded transition-all duration-200 bg-[var(--color-link)] text-white">ZH</button>
          <span class="text-muted">/</span>
          <button data-lang="auto" class="lang-btn px-2 py-1 rounded transition-all duration-200 text-muted hover:text-[var(--color-global-text)] hover:bg-[var(--color-global-bg)]">自动</button>
        </div>
      </div>
      <span class="text-muted">/</span>
      <div class="flex items-center gap-1" id="theme-switcher">
        <button id="theme-dark" class="px-2 py-1 rounded transition-all duration-200 text-muted hover:text-[var(--color-global-text)] hover:bg-[var(--color-global-bg)]">深色</button>
        <span class="text-muted">/</span>
        <button id="theme-light" class="px-2 py-1 rounded transition-all duration-200 bg-[var(--color-link)] text-white">浅色</button>
      </div>
    </div>

    <!-- 第2层：身份标题 -->
    <div class="pb-4 border-b border-[var(--color-border)]">
      <p class="font-mono text-muted text-sm">ernest@hangzhou:~$ whoami</p>
      <h1 class="text-2xl font-medium text-[var(--color-global-text)] mt-1">你好，我是 Ernest</h1>
    </div>

    <!-- 第3层：格言 -->
    <p class="text-lg text-muted italic">
      活出自我
    </p>

    <!-- 第4层：社交链接 -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm pb-4 border-b border-[var(--color-border)]">
      <a href="https://www.xiaohongshu.com/user/profile/64be88d1000000001403cf18" target="_blank" rel="noopener" class="text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200 hover:underline underline-offset-2">
        小红书
      </a>
      <a href="https://github.com/giraffe-tree" target="_blank" rel="noopener" class="text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200 hover:underline underline-offset-2">
        GitHub
      </a>
      <span class="text-muted">RSS (待补充)</span>
      <button id="copy-email" class="flex items-center gap-1 text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200 hover:underline underline-offset-2" data-email="giraffetree1@gmail.com">
        <span>Email</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
          <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
        </svg>
      </button>
      <span id="copy-toast" class="text-xs text-muted opacity-0 transition-opacity">已复制!</span>
    </div>

    <!-- 第5层：标签 -->
    <div class="flex flex-wrap items-center gap-2 pb-4">
      {tags.map((tag) => (
        <span class="px-3 py-1 text-xs bg-[var(--color-global-bg)] text-muted rounded-full border border-[var(--color-border)] hover:border-[var(--color-link)] hover:text-[var(--color-global-text)] transition-all duration-200 cursor-default">
          {tag}
        </span>
      ))}
    </div>

    <!-- 第6层：分类内容 -->
    <div class="pt-6 border-t border-[var(--color-border)]">
      <!-- 分类导航 -->
      <div class="flex items-center gap-6 mb-6 border-b border-[var(--color-border)]">
        {categories.map((cat, index) => (
          <button
            data-category={cat.id}
            class={`category-tab relative pb-3 px-2 -mx-2 text-sm font-medium rounded-t-lg transition-all duration-300 border-b-2 -mb-[2px] ${
              index === 0
                ? "border-[var(--color-link)] text-[var(--color-global-text)]"
                : "border-transparent text-muted hover:text-[var(--color-global-text)] hover:border-[var(--color-link)] hover:bg-[var(--color-global-bg)]"
            }`}
          >
            <span class="relative">
              {cat.name}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[var(--color-link)] transition-all duration-300 group-hover:w-full"></span>
            </span>
            <span class="ml-1 text-xs text-muted">({cat.posts.length})</span>
          </button>
        ))}
      </div>

      <!-- 分类内容 -->
      <div class="category-content">
        {categories.map((cat, index) => (
          <div
            data-category-content={cat.id}
            class={index === 0 ? "" : "hidden"}
          >
            {cat.posts.length === 0 ? (
              <p class="text-muted text-sm">暂无{cat.name}内容</p>
            ) : (
              <ul class="space-y-2" role="list">
                {cat.posts.slice(0, 5).map((post) => (
                  <li class="group">
                    <a href={`/posts/${post.id}/`} class="block p-3 rounded-lg hover:bg-[var(--color-global-bg)] transition-all duration-200 -mx-3">
                      <div class="flex items-baseline gap-3">
                        <h3 class="text-base font-medium text-[var(--color-global-text)] group-hover:text-[var(--color-link)] transition-colors duration-200">
                          {post.data.title}
                        </h3>
                        <span class="text-xs text-muted tabular-nums">
                          {new Date(post.data.publishDate).toLocaleDateString("zh-CN", {
                            year: "numeric",
                            month: "2-digit",
                            day: "2-digit",
                          })}
                        </span>
                      </div>
                      <p class="text-sm text-muted line-clamp-2 mt-1">{post.data.description}</p>
                      {post.data.tags.length > 0 && (
                        <div class="flex gap-2 mt-2">
                          {post.data.tags.slice(0, 3).map((tag) => (
                            <span class="text-xs text-muted">#{tag}</span>
                          ))}
                        </div>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</PageLayout>

<script>
  // 邮箱复制功能
  const copyBtn = document.getElementById('copy-email');
  const toast = document.getElementById('copy-toast');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email;
    if (email) {
      try {
        await navigator.clipboard.writeText(email);
        toast?.classList.remove('opacity-0');
        setTimeout(() => {
          toast?.classList.add('opacity-0');
        }, 2000);
      } catch (err) {
        console.error('复制失败:', err);
      }
    }
  });

  // 分类切换功能
  const categoryTabs = document.querySelectorAll('.category-tab');
  const categoryContents = document.querySelectorAll('[data-category-content]');

  categoryTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const categoryId = tab.dataset.category;

      // 更新标签样式
      categoryTabs.forEach((t) => {
        t.classList.remove('border-[var(--color-link)]', 'text-[var(--color-global-text)]');
        t.classList.add('border-transparent', 'text-muted');
      });
      tab.classList.remove('border-transparent', 'text-muted');
      tab.classList.add('border-[var(--color-link)]', 'text-[var(--color-global-text)]');

      // 更新内容显示
      categoryContents.forEach((content) => {
        if (content.dataset.categoryContent === categoryId) {
          content.classList.remove('hidden');
        } else {
          content.classList.add('hidden');
        }
      });
    });
  });

  // 主题切换功能
  const themeDark = document.getElementById('theme-dark');
  const themeLight = document.getElementById('theme-light');
  const html = document.documentElement;

  function updateThemeButtons(theme: string) {
    if (theme === 'dark') {
      themeDark?.classList.add('bg-[var(--color-link)]', 'text-white');
      themeDark?.classList.remove('text-muted');
      themeLight?.classList.remove('bg-[var(--color-link)]', 'text-white');
      themeLight?.classList.add('text-muted');
    } else {
      themeLight?.classList.add('bg-[var(--color-link)]', 'text-white');
      themeLight?.classList.remove('text-muted');
      themeDark?.classList.remove('bg-[var(--color-link)]', 'text-white');
      themeDark?.classList.add('text-muted');
    }
  }

  themeDark?.addEventListener('click', () => {
    html.setAttribute('data-theme', 'dark');
    localStorage.setItem('theme', 'dark');
    updateThemeButtons('dark');
  });

  themeLight?.addEventListener('click', () => {
    html.setAttribute('data-theme', 'light');
    localStorage.setItem('theme', 'light');
    updateThemeButtons('light');
  });

  // 初始化主题按钮状态
  const currentTheme = html.getAttribute('data-theme') || 'light';
  updateThemeButtons(currentTheme);

  // 初始化语言按钮状态
  const currentLang = localStorage.getItem('lang') || 'zh';
  updateLangButtons(currentLang);

  // 语言切换功能
  const langButtons = document.querySelectorAll('.lang-btn');

  function updateLangButtons(activeLang: string) {
    langButtons.forEach((btn) => {
      const btnLang = btn.dataset.lang;
      if (btnLang === activeLang) {
        btn.classList.remove('text-muted', 'hover:text-[var(--color-global-text)]', 'hover:bg-[var(--color-global-bg)]');
        btn.classList.add('bg-[var(--color-link)]', 'text-white');
      } else {
        btn.classList.remove('bg-[var(--color-link)]', 'text-white');
        btn.classList.add('text-muted', 'hover:text-[var(--color-global-text)]', 'hover:bg-[var(--color-global-bg)]');
      }
    });
  }

  langButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang;
      localStorage.setItem('lang', lang || 'auto');
      updateLangButtons(lang || 'zh');

      // 这里可以添加页面语言切换逻辑
      if (lang && lang !== 'auto') {
        document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
      }
    });
  });
</script>
