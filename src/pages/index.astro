---
import { type CollectionEntry } from "astro:content";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];

// Filter posts by category tags
const projects = allPostsByDate.filter(p => p.data.tags.includes("项目"));
const writings = allPostsByDate.filter(p => p.data.tags.includes("写作") || p.data.tags.includes("blog"));
const photography = allPostsByDate.filter(p => p.data.tags.includes("摄影") || p.data.tags.includes("photo"));
const travel = allPostsByDate.filter(p => p.data.tags.includes("旅行") || p.data.tags.includes("travel"));

const categories = [
  { id: "writings", name: "写作", tag: "写作", posts: writings },
  { id: "projects", name: "项目", tag: "项目", posts: projects },
  { id: "photography", name: "摄影", tag: "摄影", posts: photography },
  { id: "travel", name: "旅行", tag: "旅行", posts: travel },
];

const tags = ["builder", "人本主义", "build in public"];
---

<PageLayout meta={{ title: "Home" }} showHeader={false}>
  <div class="space-y-6">
    <!-- 第1层：主导航 -->
    <nav class="flex items-center gap-6 py-3 border-b border-[var(--color-border)]">
      <a href="/posts/" class="text-sm font-medium text-[var(--color-global-text)] hover:text-[var(--color-link)] transition-colors">文章</a>
      <a href="/notes/" class="text-sm font-medium text-[var(--color-global-text)] hover:text-[var(--color-link)] transition-colors">笔记</a>
      <a href="/about/" class="text-sm font-medium text-[var(--color-global-text)] hover:text-[var(--color-link)] transition-colors">关于</a>
    </nav>

    <!-- 第3层：身份标题 -->
    <div class="pb-4 border-b border-[var(--color-border)]">
      <!-- 命令行输入 -->
      <div class="font-mono text-muted text-sm min-h-[1.5em] overflow-hidden">
        <span class="terminal-prompt hidden sm:inline">ernest@hangzhou:~$ </span>
        <span class="terminal-prompt sm:hidden">~$ </span>
        <span id="typewriter-command"></span><span id="command-cursor" class="cursor">█</span>
      </div>
      <!-- 命令输出 -->
      <div class="text-2xl font-medium text-[var(--color-global-text)] mt-2 min-h-[1.5em]">
        <span id="typewriter-output"></span><span id="output-cursor" class="cursor hidden">█</span>
      </div>
    </div>

    <style>
      .cursor {
        display: inline-block;
        animation: blink 1s step-end infinite;
        color: var(--color-link);
        font-weight: normal;
      }
      .cursor.typing {
        animation: none;
        opacity: 1;
      }
      @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }
    </style>

    <script>
      // 打字机动画
      const commandText = 'whoami';
      const outputText = '你好，我是 Ernest，一个喜欢思考的人本主义开发者。';
      const commandEl = document.getElementById('typewriter-command');
      const outputEl = document.getElementById('typewriter-output');
      const commandCursor = document.getElementById('command-cursor');
      const outputCursor = document.getElementById('output-cursor');

      async function typeText(element: HTMLElement, text: string, speed: number = 80): Promise<void> {
        return new Promise((resolve) => {
          let i = 0;
          const type = () => {
            if (i < text.length) {
              element.textContent += text[i];
              i++;
              setTimeout(type, speed + Math.random() * 40 - 20);
            } else {
              resolve();
            }
          };
          type();
        });
      }

      async function startTypewriter() {
        // 第一阶段：输入 whoami
        commandCursor?.classList.add('typing');
        await typeText(commandEl!, commandText, 100);
        commandCursor?.classList.remove('typing');

        // 停顿一下
        await new Promise(r => setTimeout(r, 400));

        // 隐藏命令行光标，显示输出行光标
        if (commandCursor) {
          commandCursor.style.display = 'none';
        }
        outputCursor?.classList.remove('hidden');
        outputCursor?.classList.add('typing');

        // 第二阶段：输出个人介绍
        await typeText(outputEl!, outputText, 60);
        if (outputCursor) {
          outputCursor.style.display = 'none';
        }
      }

      // 页面加载后开始动画
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startTypewriter);
      } else {
        startTypewriter();
      }
    </script>

    <!-- 第3层：格言 -->
    <p class="text-lg text-muted italic mb-2">
      活出自我, 过你愿意重复的一天
    </p>

    <!-- 第4层：标签 -->
    <div class="flex flex-wrap items-center gap-2 pb-2">
      {tags.map((tag) => (
        <span class="px-3 py-1 text-xs bg-[var(--color-global-bg)] text-muted rounded-full border border-[var(--color-border)] hover:border-[var(--color-link)] hover:text-[var(--color-global-text)] transition-all duration-200 cursor-default">
          {tag}
        </span>
      ))}
    </div>

    <!-- 第5层：社交链接 -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm pb-2 border-b border-[var(--color-border)]">
      <a href="https://www.xiaohongshu.com/user/profile/64be88d1000000001403cf18" target="_blank" rel="noopener" class="text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200 hover:underline underline-offset-2">
        小红书
      </a>
      <a href="https://github.com/giraffe-tree" target="_blank" rel="noopener" class="text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200 hover:underline underline-offset-2">
        GitHub
      </a>
      <span class="text-muted">RSS (待补充)</span>
      <button id="copy-email" class="flex items-center gap-1 text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200 hover:underline underline-offset-2" data-email="giraffetree1@gmail.com">
        <span>Email</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
          <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
        </svg>
      </button>
      <span id="copy-toast" class="text-xs text-muted opacity-0 transition-opacity">已复制!</span>
    </div>

    <!-- 第6层：分类内容 -->
      <!-- 分类导航 -->
      <div class="flex items-center gap-6 mb-6 border-b border-[var(--color-border)] overflow-x-auto pb-0 -mx-6 px-6 sm:mx-0 sm:px-0 scrollbar-hide">
        {categories.map((cat, index) => (
          <button
            data-category={cat.id}
            class={`category-tab relative pb-3 px-2 -mx-2 text-sm font-medium rounded-t-lg transition-all duration-300 border-b-2 -mb-[2px] whitespace-nowrap ${
              index === 0
                ? "border-[var(--color-link)] text-[var(--color-global-text)]"
                : "border-transparent text-muted hover:text-[var(--color-global-text)] hover:border-[var(--color-link)] hover:bg-[var(--color-global-bg)]"
            }`}
          >
            <span class="relative">
              {cat.name}
              <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[var(--color-link)] transition-all duration-300 group-hover:w-full"></span>
            </span>
            <span class="ml-1 text-xs text-muted">({cat.posts.length})</span>
          </button>
        ))}
      </div>

      <!-- 分类内容 -->
      <div class="category-content">
        {categories.map((cat, index) => (
          <div
            data-category-content={cat.id}
            class={index === 0 ? "" : "hidden"}
          >
            {cat.posts.length === 0 ? (
              <p class="text-muted text-sm">暂无{cat.name}内容</p>
            ) : (
              <>
                <ul class="space-y-2" role="list">
                  {cat.posts.slice(0, 5).map((post) => (
                    <li class="group">
                      <a href={`/posts/${post.id}/`} class="block p-3 rounded-lg hover:bg-[var(--color-global-bg)] transition-all duration-200 -mx-3">
                        <div class="flex items-baseline gap-3">
                          <h3 class="text-base font-medium text-[var(--color-global-text)] group-hover:text-[var(--color-link)] transition-colors duration-200">
                            {post.data.title}
                          </h3>
                          <span class="text-xs text-muted tabular-nums">
                            {new Date(post.data.publishDate).toLocaleDateString("zh-CN", {
                              year: "numeric",
                              month: "2-digit",
                              day: "2-digit",
                            })}
                          </span>
                        </div>
                        <p class="text-sm text-muted line-clamp-2 mt-1">{post.data.description}</p>
                        {post.data.tags.length > 0 && (
                          <div class="flex gap-2 mt-2">
                            {post.data.tags.slice(0, 3).map((tag) => (
                              <span class="text-xs text-muted">#{tag}</span>
                            ))}
                          </div>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
                {cat.posts.length > 5 && (
                  <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
                    <a href={`/tags/${cat.tag}/`} class="inline-flex items-center gap-1 text-sm text-[var(--color-link)] hover:text-[var(--color-global-text)] transition-colors duration-200">
                      <span>查看更多</span>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                      </svg>
                    </a>
                  </div>
                )}
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</PageLayout>

<script>
  // 邮箱复制功能
  const copyBtn = document.getElementById('copy-email');
  const toast = document.getElementById('copy-toast');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email;
    if (email) {
      try {
        await navigator.clipboard.writeText(email);
        toast?.classList.remove('opacity-0');
        setTimeout(() => {
          toast?.classList.add('opacity-0');
        }, 2000);
      } catch (err) {
        console.error('复制失败:', err);
      }
    }
  });

  // 分类切换功能
  const categoryTabs = document.querySelectorAll('.category-tab');
  const categoryContents = document.querySelectorAll('[data-category-content]');

  categoryTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const categoryId = tab.dataset.category;

      // 更新标签样式
      categoryTabs.forEach((t) => {
        t.classList.remove('border-[var(--color-link)]', 'text-[var(--color-global-text)]');
        t.classList.add('border-transparent', 'text-muted');
      });
      tab.classList.remove('border-transparent', 'text-muted');
      tab.classList.add('border-[var(--color-link)]', 'text-[var(--color-global-text)]');

      // 更新内容显示
      categoryContents.forEach((content) => {
        if (content.dataset.categoryContent === categoryId) {
          content.classList.remove('hidden');
        } else {
          content.classList.add('hidden');
        }
      });
    });
  });
</script>
