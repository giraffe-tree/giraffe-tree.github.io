---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import ParticleBackground from "@/components/ParticleBackground.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	showHeader?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	showHeader = true,
} = Astro.props;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text relative mx-auto flex min-h-screen max-w-4xl flex-col px-6 pt-6 font-sans text-base antialiased"
	>
		<ParticleBackground />
		<SkipLink />
		{showHeader && <Header />}
		<main id="main" class="bg-[var(--color-surface)] shadow-sm rounded-lg px-6 sm:px-8 pt-3 pb-6 sm:pb-8 relative z-10">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
